NODE_ENV=development
LOG_LEVEL=info

BANK_APP_BASE_URL=http://127.0.0.1:8080

BANK_STAFF_USERNAME=
BANK_STAFF_PASSWORD=
BANK_NON_STAFF_USERNAME=
BANK_NON_STAFF_PASSWORD=
BANK_CUSTOMER_USERNAME=customer

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

DISCOVERY_SEND_SCREENSHOTS=false
DISCOVERY_MAX_MODEL_CALLS=30
DISCOVERY_MAX_ACTIONS=30
DISCOVERY_TIMEOUT_MS=120000
DISCOVERY_MAX_REPEATED_STATES=3
DISCOVERY_MAX_CONSECUTIVE_FAILURES=3

BROWSER_HEADLESS=false

OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=3210

ARTIFACTS_DIR=../artifacts
POLICIES_DIR=../policies
EVIDENCE_DIR=../evidence
