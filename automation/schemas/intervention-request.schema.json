{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "interventionId": { "$ref": "#/$defs/__schema0" },
    "runId": { "$ref": "#/$defs/__schema0" },
    "artifactId": { "$ref": "#/$defs/__schema0" },
    "artifactVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "currentStepId": { "$ref": "#/$defs/__schema0" },
    "capabilitySummary": { "$ref": "#/$defs/__schema1" },
    "reasonCode": {
      "type": "string",
      "enum": [
        "repeatedNoProgress",
        "ambiguousTarget",
        "unknownDialog",
        "checkpointFailure",
        "policyApproval",
        "riskyAction",
        "manualTestInjection",
        "unknownFailure"
      ]
    },
    "explanation": { "$ref": "#/$defs/__schema1" },
    "currentUrl": { "type": "string", "format": "uri" },
    "surfaceIdentity": { "maxLength": 256, "$ref": "#/$defs/__schema1" },
    "expectedState": { "$ref": "#/$defs/__schema2" },
    "observedState": { "$ref": "#/$defs/__schema2" },
    "recentActions": { "maxItems": 8, "type": "array", "items": { "$ref": "#/$defs/__schema4" } },
    "evidence": { "maxItems": 16, "type": "array", "items": { "$ref": "#/$defs/__schema5" } },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "controlOwner": { "type": "string", "enum": ["automation", "human", "none"] },
    "status": {
      "type": "string",
      "enum": ["requested", "humanActive", "resuming", "resolved", "aborted"]
    },
    "suggestedResumeBehavior": { "$ref": "#/$defs/__schema1" }
  },
  "required": [
    "interventionId",
    "runId",
    "capabilitySummary",
    "reasonCode",
    "explanation",
    "recentActions",
    "evidence",
    "requestedAt",
    "controlOwner",
    "status",
    "suggestedResumeBehavior"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 512 },
    "__schema2": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "maxItems": 100, "type": "array", "items": { "$ref": "#/$defs/__schema2" } },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema3" },
          "additionalProperties": { "$ref": "#/$defs/__schema2" }
        }
      ]
    },
    "__schema3": { "type": "string", "maxLength": 128 },
    "__schema4": { "maxLength": 256, "$ref": "#/$defs/__schema1" },
    "__schema5": {
      "type": "object",
      "properties": {
        "evidenceId": { "$ref": "#/$defs/__schema0" },
        "kind": {
          "type": "string",
          "enum": [
            "screenshot",
            "semanticSnapshot",
            "domSnapshot",
            "trace",
            "eventLog",
            "result",
            "artifact",
            "intervention"
          ]
        },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sanitization": { "type": "string", "enum": ["sanitized", "redacted", "synthetic"] },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mediaType": { "maxLength": 128, "$ref": "#/$defs/__schema1" }
      },
      "required": ["evidenceId", "kind", "path", "sanitization"],
      "additionalProperties": false
    }
  }
}
